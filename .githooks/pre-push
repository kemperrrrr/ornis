#!/bin/sh
# Ornis pre-push gate (installed by `cargo xtask install-hooks`).
#
# Fast by default: `cargo fmt --all -- --check`, then `cargo check
# --all-targets` only for workspace packages touched by the commits being
# pushed (see `xtask/src/prepush/`). Root Cargo.toml, Cargo.lock, .cargo/,
# and rust-toolchain.toml widen that check to the whole workspace.
# GitHub Actions stays the full gate (clippy, test, gpu, docs, rustqual,
# outdated).
#
# ORNIS_PREPUSH_FULL=1   cargo check --workspace --all-targets
# ORNIS_HOOK_FULL=1       also clippy --workspace and the wasm32 check
# git push --no-verify    git skips this hook entirely
#
# Uses target/hook unless CARGO_TARGET_DIR is already set, so the check
# does not take rust-analyzer's lock on target/.
set -eu
ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

if [ -z "${CARGO_TARGET_DIR:-}" ]; then
    export CARGO_TARGET_DIR="$ROOT/target/hook"
    echo "pre-push: CARGO_TARGET_DIR=$CARGO_TARGET_DIR"
fi

echo "pre-push: cargo fmt --all -- --check"
cargo fmt --all -- --check

# `cargo run` would hold the process open; the xtask binary reads the
# pre-push ref list from stdin and runs the scoped cargo check itself.
exec cargo xtask pre-push "$@"
